#!/usr/bin/env bash
# Read-only live dashboard: arm joint positions + Kinesis band stream.
# usage: scripts/dashboard [--port /dev/cu.usbmodem…] [--url 'KINESIS_STREAM_URL']
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
venv_python="$repo_root/.local/arm-venv/bin/python"
driver_src="$repo_root/.local/hiwonder-SoArm-101/src"
if [[ -x "$venv_python" && -d "$driver_src" ]]; then
  export PYTHONPATH="$driver_src${PYTHONPATH:+:$PYTHONPATH}"
  exec "$venv_python" -m neural_reflex.dashboard "$@"
fi
for arg in "$@"; do
  if [[ "$arg" == "--port" ]]; then
    echo "Run ./scripts/setup_leader_arm.sh first to show the arm" >&2
    exit 1
  fi
done
exec python3 -m neural_reflex.dashboard "$@"
