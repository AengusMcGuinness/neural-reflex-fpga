#!/usr/bin/env bash
# Teach movements and drive robot motors with them.
# usage: scripts/movements teach --url 'KINESIS_URL' --session data/sessions/ID [--name set-1]
#        scripts/movements live  --url 'KINESIS_URL' --model data/sessions/ID/movements/set-1/model.json [--port /dev/cu.… --execute]
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
venv_python="$repo_root/.local/arm-venv/bin/python"
driver_src="$repo_root/.local/hiwonder-SoArm-101/src"
if [[ ! -x "$venv_python" || ! -d "$driver_src" ]]; then
  echo "Run ./scripts/setup_leader_arm.sh first" >&2
  exit 1
fi
cd "$repo_root"
export PYTHONPATH="$driver_src${PYTHONPATH:+:$PYTHONPATH}"
exec "$venv_python" -m neural_reflex.movements "$@"
